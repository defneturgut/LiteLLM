# Development Configs
LITELLM_MASTER_KEY = "sk-1234"
STORE_MODEL_IN_DB = "True"

# --- Bu fork'un local docker-compose.yml'i icin ek degerler ---
# DB'deki provider anahtarlarini sifrelemek icin kullanilir -- rastgele,
# uzun bir deger sec.
LITELLM_SALT_KEY = "change-me-salt-key"

# Admin UI (http://localhost:4000/ui) giris bilgileri.
UI_USERNAME = "admin"
UI_PASSWORD = "change-me-password"

# Postgres (varsayilanlar sadece container-ici, host'a acik degil --
# yine de degistirmen onerilir).
POSTGRES_USER = "litellm"
POSTGRES_PASSWORD = "change-me-db-password"
POSTGRES_DB = "litellm"

# config/config.yaml'daki "disaridaki-model-denemesi" modeli icin -- host'taki
# 8090 portunda calisan kendi/harici bir sunucun varsa onun key'i. Kullanmiyorsan
# bos birakabilirsin.
DISARIDAKI_MODEL_API_KEY = ""

# general_settings.alerting: ["webhook"] (config/config.yaml) butce/hata
# uyarilarini buraya POST eder. Bos birakirsan docker-compose.yml'deki
# webhook-alici servisine gider (ham JSON'u ekrana basar, alerting'in
# gercekten calistigini gormek icin) -- kendi alicin varsa burayi doldur.
WEBHOOK_URL = ""
